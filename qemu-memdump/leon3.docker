FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential     \
    wget                \
    xz-utils            \
    libgmp-dev          \
    libmpfr-dev         \
    libmpc-dev          \
    texinfo             \
    qemu-system-sparc   \
    ninja-build         \
    python3             \
    python3-venv        \
    cmake               \
    && rm -rf /var/lib/apt/lists/*

ARG TARGET=sparc-elf
ARG PREFIX=/opt/cross
ARG BINUTILS_VER=2.42
ARG GCC_VER=13.3.0
ARG NEWLIB_VER=4.4.0.20231231

ENV PATH="${PREFIX}/bin:${PATH}"

WORKDIR /tmp/toolchain

RUN wget -q https://ftp.gnu.org/gnu/binutils/binutils-${BINUTILS_VER}.tar.xz && \
    tar xf binutils-${BINUTILS_VER}.tar.xz && \
    rm  binutils-${BINUTILS_VER}.tar.xz

RUN mkdir build-binutils && cd build-binutils && \
    ../binutils-${BINUTILS_VER}/configure \
        --target=${TARGET} \
        --prefix=${PREFIX} \
        --disable-nls \
        --disable-werror \
    && make -j$(nproc) \
    && make install \
    && cd .. && rm -rf build-binutils binutils-${BINUTILS_VER}

RUN wget -q https://ftp.gnu.org/gnu/gcc/gcc-${GCC_VER}/gcc-${GCC_VER}.tar.xz && \
    tar xf gcc-${GCC_VER}.tar.xz && \
    rm  gcc-${GCC_VER}.tar.xz

RUN wget -q https://sourceware.org/pub/newlib/newlib-${NEWLIB_VER}.tar.gz && \
    tar xf newlib-${NEWLIB_VER}.tar.gz && \
    rm  newlib-${NEWLIB_VER}.tar.gz && \
    ln -s /tmp/toolchain/newlib-${NEWLIB_VER}/newlib   gcc-${GCC_VER}/newlib && \
    ln -s /tmp/toolchain/newlib-${NEWLIB_VER}/libgloss gcc-${GCC_VER}/libgloss

RUN mkdir build-gcc && cd build-gcc && \
    ../gcc-${GCC_VER}/configure \
        --target=${TARGET} \
        --prefix=${PREFIX} \
        --enable-languages=c,c++ \
        --with-newlib \
        --with-gnu-as \
        --with-gnu-ld \
        --disable-multilib \
        --disable-shared \
        --disable-threads \
        --disable-libssp \
        --disable-nls \
        --disable-werror \
    && make -j$(nproc) \
    && make install \
    && cd .. && rm -rf build-gcc gcc-${GCC_VER} newlib-${NEWLIB_VER}

RUN rm -rf /tmp/toolchain

RUN python3 -m venv /tmp/venv

RUN /tmp/venv/bin/python -m pip --no-cache-dir install  \
    pyelftools  

